#! /bin/bash

BIN=/usr/bin/chromium-browser

# Cleanup
if ! pgrep chromium > /dev/null;then
  rm -f $HOME/.config/chromium/Singleton*
fi

# Run normally on privved containers or modified un non priv
if grep -q 'Seccomp:.0' /proc/1/status; then
  ${BIN} --no-first-run --password-store=basic --enable-features=UseOzonePlatform --ozone-platform=wayland "$@"
else
  ${BIN} --no-first-run --password-store=basic --no-sandbox --test-type --enable-features=UseOzonePlatform --ozone-platform=wayland "$@"
fi
